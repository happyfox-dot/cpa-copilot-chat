{
  "name": "cpa-copilot-chat",
  "displayName": "CPA Proxy for Copilot Chat",
  "description": "Seamlessly use your local CPA reverse proxy models (Claude 3.7, Gemini 2.0/3.8, DeepSeek-R1, etc.) directly in GitHub Copilot Chat.",
  "version": "1.0.0",
  "publisher": "happyfox",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyfox-dot/cpa-copilot-chat.git"
  },
  "homepage": "https://github.com/happyfox-dot/cpa-copilot-chat#readme",
  "bugs": {
    "url": "https://github.com/happyfox-dot/cpa-copilot-chat/issues"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "cpa",
    "copilot",
    "copilot-chat",
    "byok",
    "claude",
    "gemini",
    "deepseek",
    "openai",
    "proxy",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:cpa"
  ],
  "main": "./extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "cpa",
        "displayName": "CPA Proxy"
      }
    ],
    "commands": [
      {
        "command": "cpa-copilot.refreshModels",
        "title": "CPA: Refresh Models in Copilot Chat"
      },
      {
        "command": "cpa-copilot.openSettings",
        "title": "CPA: Open Settings"
      }
    ],
    "configuration": {
      "title": "CPA Copilot",
      "properties": {
        "cpa-copilot.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8317/v1",
          "description": "Base URL of your local CPA service."
        },
        "cpa-copilot.apiKey": {
          "type": "string",
          "default": "123456",
          "description": "API Key for your local CPA service."
        },
        "cpa-copilot.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for completions."
        },
        "cpa-copilot.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Max output tokens (0 to use API default)."
        }
      }
    }
  }
}
